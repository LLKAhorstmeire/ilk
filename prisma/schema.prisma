# Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  cash          Float     @default(100000)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  holdings      Holding[]
  orders        Order[]
  transactions  Transaction[]
  alerts        Alert[]
  watchlist     WatchlistItem[]
  isAdmin       Boolean   @default(false)
  isDemo        Boolean   @default(false)
}

model Asset {
  id            String    @id @default(cuid())
  symbol        String    @unique
  name          String
  price         Float
  change        Float
  percentChange Float
  marketCap     Float?
  volume        Float?
  color         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  holdings      Holding[]
  orders        Order[]
  alerts        Alert[]
  watchlist     WatchlistItem[]
}

model Holding {
  id            String   @id @default(cuid())
  userId        String
  assetId       String
  quantity      Float
  averagePrice  Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id])
  asset         Asset    @relation(fields: [assetId], references: [id])

  @@unique([userId, assetId])
}

model Order {
  id            String    @id @default(cuid())
  userId        String
  assetId       String
  side          String
  type          String
  quantity      Float
  price         Float
  status        String    @default("open")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id])
  asset         Asset     @relation(fields: [assetId], references: [id])
}

model Transaction {
  id            String    @id @default(cuid())
  userId        String
  assetId       String?
  side          String
  quantity      Float
  price         Float
  total         Float
  type          String
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
  asset         Asset?    @relation(fields: [assetId], references: [id])
}

model WatchlistItem {
  id            String    @id @default(cuid())
  userId        String
  assetId       String
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
  asset         Asset     @relation(fields: [assetId], references: [id])

  @@unique([userId, assetId])
}

model Alert {
  id            String    @id @default(cuid())
  userId        String
  assetId       String
  condition     String
  targetPrice   Float
  enabled       Boolean   @default(true)
  triggered     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
  asset         Asset     @relation(fields: [assetId], references: [id])
}

model PortfolioHistory {
  id            String    @id @default(cuid())
  userId        String
  totalValue    Float
  cash          Float
  invested      Float
  recordedAt    DateTime  @default(now())
}
